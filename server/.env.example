# Kopyalayıp .env yapın.

# Zorunlu: uzun rastgele bir metin (oturum anahtarlarını imzalar).
JWT_SECRET=

# Zorunlu: Supabase Postgres bağlantısı.
# Supabase panel > projen > Connect > "Session pooler" adresini al,
# kullanıcıyı sportarea_app, şifreyi o role verdiğin şifre yap:
# postgresql://sportarea_app.<PROJE_REF>:<SIFRE>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
