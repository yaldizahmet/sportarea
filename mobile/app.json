{
  "expo": {
    "name": "SporArea",
    "slug": "sporarea",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "sporarea",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.sporarea.app",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "extra": {
      "eas": {
        "projectId": "95651474-2087-4805-9a20-f15db130bddb"
      }
    },
    "owner": "thend",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafını seçebilmen için galerine erişmemiz gerekiyor.",
          "cameraPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00E676"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "SporArea",
      "shortName": "SporArea",
      "themeColor": "#0F172A",
      "backgroundColor": "#0F172A",
      "lang": "tr"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "bundleIdentifier": "com.sporarea.app"
    }
  }
}
